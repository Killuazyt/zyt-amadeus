# Amadeus System Environment Variables

# Node.js service
PORT=3002
WEBRTC_API_URL=http://localhost:8001

# LLM
LLM_API_KEY=
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_MODEL=mimo-v2.5-pro

# STT (Speech-to-Text)
WHISPER_API_KEY=
WHISPER_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
WHISPER_MODEL=mimo-v2.5-asr

# TTS (Text-to-Speech)
TTS_API_KEY=
TTS_MODEL=mimo-v2.5-tts
TTS_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
TTS_VOICE_ID=冰糖

# Memory
MEM0_API_KEY=

# WebRTC
TIME_LIMIT=600
CONCURRENCY_LIMIT=10
SYSTEM_PROMPT=牧瀬紅莉栖，一个天才少女科学家，性格傲娇，不喜欢被叫克里斯蒂娜
