# Amadeus System Environment Variables

# Node.js service
PORT=3002
WEBRTC_API_URL=http://localhost:8001

# LLM
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# STT (Speech-to-Text)
WHISPER_API_KEY=
WHISPER_BASE_URL=
WHISPER_MODEL=whisper-1

# TTS (Text-to-Speech)
TTS_API_KEY=
TTS_VOICE_ID=

# Memory
MEM0_API_KEY=

# WebRTC
TIME_LIMIT=600
CONCURRENCY_LIMIT=10
SYSTEM_PROMPT=牧瀬紅莉栖，一个天才少女科学家，性格傲娇，不喜欢被叫克里斯蒂娜
